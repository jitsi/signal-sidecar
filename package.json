{
  "name": "signal-sidecar",
  "version": "0.3.3",
  "description": "health report sidecar service for jitsi signal nodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/jitsi/signal-sidecar"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "consul": "aaronkvanmeerten/node-consul",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.1",
    "express": "^4.21.2",
    "got": "^11.8.6",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "prom-client": "^12.0.0",
    "util": "^0.12.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/consul": "^0.40.0",
    "@types/express": "^4.17.7",
    "@types/got": "^9.6.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.52.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "concurrently -k -p \"[{name}]\" \"npm run watch-ts\" \"npm run watch-node\"",
    "watch-ts": "tsc -w",
    "watch-node": "nodemon dist/app.js",
    "lint": "npx eslint . --ext .ts,.tsx --fix",
    "build": "npm run lint && tsc",
    "start": "node dist/app.js",
    "jwt": "node dist/jwt.js"
  },
  "author": "Jitsi",
  "license": "Apache-2.0"
}
